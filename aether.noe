// para.aether — a first-party web framework for Noeta.
//
// Controllers are classes whose methods are tagged `#[Get("/path")]` / `#[Post("/path")]`. The `App`
// autodiscovers those routes by reflection (`attributes_of`), and for each request it reflects the
// handler's parameters (`params_of`) and INJECTS each one by its declared type — a request body
// materialized into a typed struct (`json.decode_typed`, backed by `@derive(Deserialize<Json>)`) —
// then dispatches by name (`invoke`). Laravel-style method injection, zero per-handler glue.
//
// This module is the routing + dependency-injection core. Middleware, service providers, the config
// registry, and the background-task scope layer on top of it.

use std.fs
use std.http.server
use std.http.url
use std.http.{Request, Response}
use std.json
use std.session
use std.session.{Session, Keyring}
use std.task.sleep

// --- Route attributes: users tag controller methods with these. -------------------------------

// One attribute per HTTP method, rather than one `#[Route(method: "GET", …)]` carrying the verb as
// a string: `attributes_of::<T>()` is a closed-world query keyed by TYPE, so the verb has to be part
// of the type for discovery to find it — and a misspelled `#[Gett]` is then an unknown-attribute
// error rather than a route that silently never matches.
@attribute(Method)
pub struct Get {
    path: string
}

@attribute(Method)
pub struct Post {
    path: string
}

@attribute(Method)
pub struct Put {
    path: string
}

@attribute(Method)
pub struct Patch {
    path: string
}

@attribute(Method)
pub struct Delete {
    path: string
}

// QUERY — a safe, idempotent read that carries a request body, for a search or filter too large to
// sit in a URL. It is `GET` semantics with `POST`'s payload, so the handler declares a body struct
// exactly as a `#[Post]` one does; the router matches the verb and injects the body by type, with no
// verb-specific path anywhere below. `std.http` speaks it on both ends (`client.query`, and the
// server reads the method verbatim), and the spec generator lowercases it to the `query` operation
// key the OpenAPI QUERY proposal uses.
@attribute(Method)
pub struct Query {
    path: string
}

// The status a successful reply carries, when it is not 200.
//
// It lives HERE, beside the route attributes, rather than with the spec generator, because it is a
// routing fact: the router answers with it, and the document merely reports what the router does. An
// annotation that only the document read would be a licence for the two to disagree — which is the
// one thing a generated spec exists to prevent.
//
// It applies to a reply the framework builds. A handler returning a `Response` has already chosen
// its status, and an absent `?T` answer is a 404 whatever this says.
@attribute(Method)
pub struct Status {
    code: int
    description: string = "OK"
}

// --- A resolved route in the table. -----------------------------------------------------------

// `pub` because the route table is what a spec generator reads: `para.aether.openapi` turns this
// table plus the reflected handler signatures into an OpenAPI document, and it cannot do that
// through a private type. Every field is derived — nothing here is written by hand.
pub struct Route {
    method: string // "GET" / "POST" / "PUT" / "PATCH" / "DELETE" / "QUERY"
    path: string // "/users/{id}"
    controller: string // "UsersController"
    action: string // "show"
    // The handler's reflection target VERBATIM — the key `params_of` is indexed by. Reflection
    // reports it fully qualified (`todo.main.UsersController.show` for a class in `namespace
    // todo.main`), and shortening it to `Controller.action` strands every handler that declares a
    // parameter: `params_of` answers the empty list for a key it does not hold, so the handler is
    // then invoked with no arguments and fails arity — a 500 for a route that looks perfectly fine.
    target: string
    // The `{…}` segments of `path`, in the order they appear. Injection resolves a scalar parameter
    // by name against these first, and the spec generator emits one `in: path` parameter per entry.
    // Order matters and a `Map`'s key order is sorted, so the names are kept as a list.
    path_params: List<string>
    // The success status from `#[Status]`, or 0 for "the default" — resolved once at discovery
    // rather than per request.
    status: int
}

// Build the table row for one route attribute: `target` is the reflection key the attribute was
// found under, `path` the URL template it declared.
//
// The controller and action are the LAST two dotted segments — a controller declared in a file with
// a `namespace` reflects fully qualified, and reading the first two segments would take the
// *namespace* for the controller (every route in a namespaced app then dispatched to a controller
// nobody registered: "500 no controller todo"). The class and the method are always the last two,
// namespace or not.
pub fn route_for(method: string, target: string, path: string): Route {
    parts = target.split(".")
    n = parts.len()
    return Route {
        method: method,
        path: path,
        controller: if n > 1 then parts[n - 2] else "",
        action: if n > 0 then parts[n - 1] else "",
        target: target,
        path_params: path_params_of(path),
        status: status_of(target),
    }
}

// The `#[Status]` a handler declared, or 0. `attributes_of` is a program-wide query keyed by type,
// so the join back to one handler is on the target — the same key `params_of` uses.
fn status_of(target: string): int {
    for a in attributes_of::<Status>() {
        if a.target == target {
            return a.value.code
        }
    }
    return 0
}

// The `{…}` parameter names in a route template, in order. A segment that opens `{` but never
// closes is not a parameter — a template is authored, not remote input, but silently treating
// `/a/{id` as a capture would match paths nobody meant it to.
pub fn path_params_of(pattern: string): List<string> {
    mut names: List<string> = []
    for seg in pattern.split("/") {
        if seg.starts_with("{") && seg.ends_with("}") && seg.len() > 2 {
            names = names ~ [seg.slice(1, seg.len() - 1)]
        }
    }
    return names
}

// --- Route path matching (with `{param}` capture). ---------------------------------------------

// Match a route pattern (`/users/{id}/posts/{slug}`) against a concrete request path: `none` if it
// does not match, else `some(captures)` — every `{name}` segment bound to what stood in its place.
// A pattern with no parameters matches to an empty map, which is a match, not a miss.
fn path_match(pattern: string, path: string): ?Map<string, string> {
    pp = pattern.split("/")
    ap = path.split("/")
    if pp.len() != ap.len() {
        return none
    }
    mut captures: Map<string, string> = {}
    mut i = 0
    for seg in pp {
        actual = ap[i]
        if seg.starts_with("{") && seg.ends_with("}") && seg.len() > 2 {
            // The captured value is percent-DECODED; the literal segments are compared as written.
            // A `{id}` of `for%20sale` is the string `for sale` — that is what the client named —
            // while a literal segment is part of the route's own spelling and is matched verbatim.
            captures = captures.set(seg.slice(1, seg.len() - 1), url.decode(actual))
        } else {
            if seg != actual {
                return none
            }
        }
        i = i + 1
    }
    return some(captures)
}

// Split a request target into its path and its raw query string: `"/pets?status=sold"` →
// `("/pets", "status=sold")`. The server path never sees a query here (`Request.path()` strips it,
// and `Request.query(name)` reads it), but the string-testable `app.handle("GET", "/pets?x=1", …)`
// does — and a query a test cannot express is a query the string path cannot rehearse.
fn split_query(target: string): (string, string) {
    parts = target.split("?", 2)
    return if parts.len() > 1 then (parts[0], parts[1]) else (target, "")
}

// Parse `a=1&b=2` into a map, percent-decoding both halves through `std.http.url` (decoding is
// byte-wise over UTF-8, which a string-only decoder cannot reach — `%C3%A9` is one character, not
// two). A pair with no `=` binds its key to the empty string, so `?debug` reads as present, which
// is what a server does and what a `?string` flag parameter needs.
fn parse_query(raw: string): Map<string, string> {
    mut out: Map<string, string> = {}
    if raw == "" {
        return out
    }
    for pair in raw.split("&") {
        if pair != "" {
            kv = pair.split("=", 2)
            out = out.set(form_decode(kv[0]), if kv.len() > 1 then form_decode(kv[1]) else "")
        }
    }
    return out
}

// Decode one half of a query pair: the form-encoding rule (`+` is a space) applied BEFORE
// percent-decoding, so an escaped plus (`%2B`) still arrives as a literal `+`. `url.decode` is
// deliberately percent-only — the plus rule is `application/x-www-form-urlencoded`'s, not a URL's,
// and applying it to a path segment would corrupt every path containing one.
fn form_decode(value: string): string {
    return url.decode(value.replace("+", " "))
}

// --- Background task scope & scheduler. --------------------------------------------------------
//
// The serve loop drives sibling `spawn`ed tasks (its accept loop calls `advance_tasks` each round),
// so a `concurrent { spawn work(rx); spawn every(...); serve(port, app.route) }` nursery runs the
// server, a background-job worker, and scheduled tasks together on one heap — no async-serve
// primitive needed. A handler "fires and forgets" by enqueuing a thunk onto the job channel and
// returning immediately; the worker runs it off the request path.

fn noop(): void {}

// The background worker: drain the job queue, running each enqueued thunk. Spawn one per app.
pub async fn work(rx: Receiver<() -> void>): void {
    mut going = true
    while going {
        job = rx.recv().await
        if job == none {
            going = false
        } else {
            f = job ?? noop
            f()
        }
    }
}

// Enqueue a fire-and-forget background job — the handler returns without waiting for it to run.
pub async fn background(tx: Sender<() -> void>, job: () -> void): void {
    tx.send(job).await
}

// A scheduled task: run `action` every `ms` milliseconds, forever. Spawn one per schedule.
pub async fn every(ms: int, action: () -> void): void {
    mut running = true
    while running {
        sleep(ms).await
        action()
    }
}

// --- Middleware (the onion). -------------------------------------------------------------------
//
// A middleware is a LAYER of an onion, not a before/after hook pair: `handle` receives the request
// AND `next` — the rest of the pipeline, with the routed handler at the bottom. So a layer may
// rewrite the request before continuing (`next.run(rewritten)`), inspect or replace the response on
// the way out, or answer WITHOUT ever calling `next` — an auth reject, a cache hit, a CORS preflight.
// A before/after pair cannot express "answer without dispatching", which is exactly what a
// short-circuit is; this is the same shape para/api's client-side onion uses, bottoming out in the
// app's `serve_request` rather than a client's `send`. Middlewares are `dyn Middleware` (L1),
// dispatched dynamically on their concrete type.
pub trait Middleware {
    fn handle(req: Request, next: Next): Response
}

// The rest of the pipeline, as a value. `next.run(req)` continues inward; the innermost `run` bottoms
// out in the app's `serve_request`, where the route is dispatched and the unit-of-work flushed.
//
// A cursor (stack + index), not a closure captured per layer: the stack is shared by every `Next` in
// a pipeline and only the index advances, so entering a layer allocates one small struct rather than
// capturing an environment.
pub struct Next {
    stack: List<dyn Middleware>
    index: int
    app: App

    // Continue inward. Calling this is what makes a layer transparent; NOT calling it is what makes a
    // layer answer on its own (an auth reject, a cache hit, a short-circuit reply).
    fn run(req: Request): Response {
        if self.index >= self.stack.len() {
            return self.app.serve_request(req)
        }
        rest = Next { stack: self.stack, index: self.index + 1, app: self.app }
        return self.stack[self.index].handle(req, rest)
    }
}

// Inject the live request for a handler's `Request` parameter. It is absent on the string-testable
// path (`dispatch_request` threads `none`): a handler that reads the request — a header, a cookie —
// is exercised through `serve`, where the real request exists. Panicking rather than fabricating an
// empty request keeps the string path honest about what it can and cannot cover.
fn request_arg(req: ?Request): dyn {
    return match req {
        some(r) => r,
        none => panic("400 a `Request` parameter is only available on the server path, not the string-testable `dispatch_request`"),
    }
}

// --- What one request offers an injected parameter. --------------------------------------------

// Gathered once per request so the injection reads a single value rather than a growing argument
// list. Not `pub`: it is the router's internal vocabulary, and a handler receives injected values,
// never this.
struct Bind {
    path: Map<string, string> // the route template's `{…}` captures, by name
    query: Map<string, string> // the parsed query string — the STRING path's source (see `lookup`)
    body: string
    req: ?Request
    id: string // the first `{…}` capture, for route-model binding
}

// The value a named scalar parameter should take, or `none` if the request does not offer one.
//
// Path parameters win over query parameters: a `{id}` in the template is part of the route's
// identity, and a client appending `?id=other` must not be able to redirect a handler that matched
// on the first one.
//
// The query half reads `Request.query(name)` when a live request is in hand and the parsed map
// otherwise. That is not a fallback — it is the same value from the authoritative source on each
// path: the host decodes a served request's query itself, while the string path parses the query it
// was handed. Preferring the live request keeps a served handler reading exactly what the client
// sent, percent-decoding included.
fn lookup(bind: Bind, name: string): ?string {
    if bind.path.has(name) {
        return some(bind.path[name])
    }
    return match bind.req {
        some(r) => r.query(name),
        none => if bind.query.has(name) then some(bind.query[name]) else none,
    }
}

// Inject one scalar parameter from the route or the query, parsed to its declared type.
//
// An absent value is a **client** error (400), not a 500: the request did not carry what the route
// declared. An `?T` parameter is the way to say "may be absent" — it injects `none` rather than
// failing, which is also exactly how the spec generator decides `required: false`.
//
// A value that will not parse is a 400 naming the parameter and the type it had to be — the one
// message that tells a caller what to change. Silently coercing (`"abc"` → `0`) would hand the
// handler a plausible number nobody sent.
fn scalar_arg(p: ParamInfo, bind: Bind): Result<dyn, Response> {
    inner = match p.type {
        Option(t) => t,
        t => t,
    }
    optional = match p.type {
        Option(_) => true,
        _ => false,
    }
    return match lookup(bind, p.name) {
        some(raw) => match parse_scalar(raw, inner) {
            some(v) => Ok(if optional then some(v) else v),
            none => Err(server.response(400, "400 parameter `${p.name}` is not a valid ${type_label(inner)}: \"${raw}\"")),
        },
        none => if optional then Ok(none) else Err(server.response(400, "400 missing required parameter `${p.name}`")),
    }
}

// Parse one raw URL string into the declared scalar type, or `none` when it does not represent one.
//
// `bool` accepts the spellings a URL actually carries — `true`/`1`/`yes`/`on` and their negatives,
// plus the bare `?flag` form (an empty value, which `parse_query` binds when a pair has no `=`).
// Anything else is a parse failure rather than a silent `false`.
fn parse_scalar(raw: string, ty: Type): ?dyn {
    return match ty {
        Type.String => some(raw),
        Type.Int => match raw.to_int() {
            some(n) => some(n),
            none => none,
        },
        Type.Float => match raw.to_float() {
            some(f) => some(f),
            none => none,
        },
        Type.F64 => match raw.to_float() {
            some(f) => some(f),
            none => none,
        },
        Type.F32 => match raw.to_float() {
            some(f) => some(f.to_f32()),
            none => none,
        },
        Type.Bool => match raw.lower() {
            "" => some(true),
            "true" => some(true),
            "1" => some(true),
            "yes" => some(true),
            "on" => some(true),
            "false" => some(false),
            "0" => some(false),
            "no" => some(false),
            "off" => some(false),
            _ => none,
        },
        _ => none,
    }
}

// A scalar type's name for a diagnostic — what the caller has to supply.
fn type_label(ty: Type): string {
    return match ty {
        Type.String => "string",
        Type.Int => "int",
        Type.Float => "float",
        Type.F64 => "f64",
        Type.F32 => "f32",
        Type.Bool => "bool",
        _ => "value",
    }
}

// The container key for an interface: a trait's SHORT name. A `dyn Trait` parameter reflects
// (`params_of`) with its trait name FULLY QUALIFIED — a `dyn SessionStore` in an app that imported it
// reflects as `DynTrait("para.aether.SessionStore")`, a `dyn Clock` on an app-local trait as
// `DynTrait("Clock")` — so injection and registration meet on the last dotted segment. Keying on the
// short name means a service is `bind`'d and injected by the same spelling the author writes at the
// `dyn` site (`SessionStore`), not a fully-qualified path they would have to know to reproduce.
fn short_iface(name: string): string {
    parts = name.split(".")
    return if parts.len() > 0 then parts[parts.len() - 1] else name
}

// Coerce a handler's return value into a `Response`, by what the value IS:
//
//   - a `Response`      → verbatim; its status and headers reach the client untouched,
//   - a `string`        → `200 text/plain`,
//   - anything else     → `200 application/json`, the value rendered by `json.stringify`.
//
// The third arm is the one that lets a handler be written as `fn show(id: string): Pet` — the shape
// a spec generator can read a response schema off, and the shape a caller actually wants. Before it
// existed a handler returning a struct produced the string `"200 OK"`: a reply that was neither the
// value nor an error, from code that looked correct.
//
// The RUNTIME value is inspected rather than the declared return type, so a method typed `Response`,
// `string`, `Pet`, or `dyn` all resolve at the one point the value exists — a handler returning `dyn`
// still renders as whatever it actually produced.
fn coerce_response(result: dyn, status: int): Response {
    // A handler that answered `none` said the thing is not there, and HTTP's word for that is 404.
    // The rule is read off the handler's own type — `?T` is the declaration that a result may be
    // absent — so a route-model lookup or a proxied "no such record" becomes the right status
    // without a single line about status codes in the handler. `openapi` states the same 404 in the
    // document, from the same `?T`.
    if result == none {
        return server.response(404, "404 Not Found", {"content-type": "text/plain"})
    }
    // A handler that answered a `Result` reported a failure it could not resolve itself. The `Ok`
    // continues as any other value; the `Err` is a 500 carrying its message, because a framework
    // cannot know which failure deserves which status — a handler that does returns a `Response`.
    match result.as<Result<dyn, dyn>>() {
        some(outcome) => {
            return match outcome {
                Ok(value) => coerce_response(value, status),
                Err(reason) => server.response(500, "500 ${reason}", {"content-type": "text/plain"}),
            }
        },
        none => {},
    }
    ok = if status == 0 then 200 else status
    return match result.as<Response>() {
        some(resp) => resp,
        none => match result.as<string>() {
            some(text) => server.response(ok, text, {"content-type": "text/plain"}),
            none => server.response(ok, json.stringify(result), {"content-type": "application/json"}),
        },
    }
}

// --- Configuration registry. ------------------------------------------------------------------
//
// An app-wide key/value store (`std.cell`-style shared state via the class's reference identity):
// service providers write it during setup, handlers read it. Values are strings — the caller parses
// richer shapes (a port to `int`, a JSON blob via `json.decode`).

pub class Config {
    mut values: Map<string, string>

    fn new(): Config {
        return Config { values: {} }
    }

    fn set(key: string, value: string): void {
        self.values = self.values.set(key, value)
    }

    fn get(key: string, fallback: string): string {
        return self.values.get_or(key, fallback)
    }

    fn has(key: string): bool {
        return self.values.has(key)
    }
}

// --- The data store seam (route-model binding + unit-of-work). ---------------------------------
//
// aether is deliberately database-agnostic: it depends on this `Store` interface, NOT on any concrete
// driver. An app backs it with whatever it likes — `para.db` over SQLite, an in-memory fake in tests,
// a remote service — and wires the implementation in with `app.set_store(...)`. This is the seam the
// dependency-injection layer uses for the two Laravel-style features:
//   - **route-model binding**: a handler parameter whose type is a `bind_model`'d model is loaded by
//     the route's `{id}` via `Store.load(model, id)` and injected, instead of decoded from the body.
//   - **unit-of-work**: a handler stages writes with `Store.stage(...)` during the request; aether
//     calls `Store.flush()` once, after the response is produced, so a request's writes commit as one
//     batch (the repository/unit-of-work pattern, kept off the hot path).

pub trait Store {
    // Load a bound model instance of type `model` by its route id (route-model binding).
    fn load(model: string, id: string): dyn
    // Stage a write (`data` is JSON) into the request's unit-of-work; committed on `flush`.
    fn stage(model: string, data: string): void
    // Commit every staged write — called once by aether at end-of-request.
    fn flush(): void
}

// The store an app gets before it configures one: a no-op unit-of-work. `flush`/`stage` do nothing;
// `load` refuses (a route bound a model but no store was wired to load it from). So aether always has
// a `Store` to call — no per-request `none`-checks on the hot path.
class NullStore {
    fn new(): NullStore {
        return NullStore {}
    }
}

impl Store for NullStore {
    fn load(model: string, id: string): dyn {
        return panic("no store configured — call `app.set_store(...)` to load model ${model}")
    }

    fn stage(model: string, data: string): void {}

    fn flush(): void {}
}

// --- The session-store seam. -------------------------------------------------------------------
//
// aether offers sessions behind ONE interface, so a handler reads and writes a session the same way
// regardless of where the state actually lives:
//   - the **stateless** default (`CookieSessions`) carries the whole session in a signed, HMAC'd
//     cookie via `std.session` — no server state, nothing to configure, and correct under
//     `serve --parallel` (every worker reads a cookie none of them had to write, where an in-memory
//     map would silently fragment).
//   - a **stored** upgrade keeps only a small session id in the cookie and the data server-side, for
//     sessions too large for a browser's ~4 KB cookie or that must be revocable. Per the
//     http-sessions design that impl belongs in **para/db** — it owns the connection and the
//     migrations — and aether reaches it through the `para` scope, not a hard dependency.
//
// A handler obtains its session with `store.open(req)` and persists it with `store.attach(resp, s)`.
// `Session` is `std.session`'s own type, so the two backends are interchangeable at the call site: a
// handler written against `CookieSessions` moves to the stored backend without a line changing.
pub trait SessionStore {
    // The session carried by this request — an empty one when the request has no valid session (the
    // caller has the same correct response to "absent", "forged", and "expired").
    fn open(req: Request): Session
    // Persist `session` onto `resp` and return the reply to send: a `Set-Cookie` for the stateless
    // default, a row write plus a small id cookie for a stored backend. An unchanged session costs
    // no header, so calling this unconditionally is safe.
    fn attach(resp: Response, session: Session): Response
}

// The stateless default: the whole session rides in a signed cookie (`std.session`). Wire it once and
// hand it to handlers. `secure` should be true behind https — it makes the cookie https-only; leave
// it false only for a plain-http localhost. `max_age` (seconds) bounds a stolen token's lifetime,
// which matters precisely because a stateless session has nothing to revoke against.
pub class CookieSessions {
    keys: Keyring
    max_age: int
    secure: bool

    fn new(keys: Keyring, max_age: int, secure: bool): CookieSessions {
        return CookieSessions { keys: keys, max_age: max_age, secure: secure }
    }

    impl SessionStore {
        fn open(req: Request): Session {
            return session.open(req, self.keys)
        }

        fn attach(resp: Response, s: Session): Response {
            return session.attach(resp, s, self.keys, self.max_age, self.secure)
        }
    }
}

// --- Service providers. -----------------------------------------------------------------------
//
// A service provider modularizes application setup: its `register(app)` wires controllers, config,
// and middleware into the app. Registering a provider runs its `register` immediately (Laravel's
// deferred `boot` phase awaits trait default methods — UT5). Providers are `dyn ServiceProvider`
// (L1), so an app composes features by registering a list of them.

pub trait ServiceProvider {
    fn register(app: App): void
}

// --- The application. -------------------------------------------------------------------------

pub class App {
    mut routes: List<Route>
    mut controllers: Map<string, dyn>
    mut middleware: List<dyn Middleware>
    mut bound: List<string> // model type names that are route-bound (loaded from the store by id)
    mut store: dyn Store // the data-store seam (a NullStore until an app configures one)
    mut services: Map<string, dyn> // the service container: concrete instances keyed by interface (short trait name)
    mut static_dir: string // filesystem root served for unmatched GETs ("" = no static mount)
    config: Config

    fn new(): App {
        store = NullStore.new()
        app = App { routes: [], controllers: {}, middleware: [], bound: [], store: store, services: {}, static_dir: "", config: Config.new() }
        // The data `Store` is a service like any other — registered under `Store` so a `dyn Store`
        // parameter resolves through the same container. `set_store` keeps this entry in step with the
        // typed `store` field the flush/route-model path calls through.
        app.bind("Store", store)
        return app
    }

    // Wire in the data store an app's models load/persist through (its `para.db`-backed impl, a test
    // fake, …). Injected handler parameters and the end-of-request flush dispatch through it.
    fn set_store(s: dyn Store): void {
        self.store = s
        // Keep the container's `Store` entry pointing at the live store, so `dyn Store` injection and
        // the `store` field the flush/route-model path uses never diverge.
        self.bind("Store", s)
    }

    // Register a concrete service instance under the interface a `dyn <name>` parameter resolves by.
    // `name` is the interface's SHORT trait name (`"Store"`, `"SessionStore"`, `"Clock"`) — the same
    // last segment `arg_for` normalizes a reflected `dyn Trait` to, so a service registered here is the
    // one injected there. Providers call this during setup; re-binding a name replaces the service.
    fn bind(name: string, service: dyn): void {
        self.services = self.services.set(name, service)
    }

    // Mark a model type as **route-bound**: a handler parameter of this type is loaded from the store
    // by the route's `{id}` (Laravel implicit binding), instead of being decoded from the request body.
    fn bind_model(name: string): void {
        self.bound = self.bound ~ [name]
    }

    // Whether `name` names a route-bound model.
    fn is_bound(name: string): bool {
        for b in self.bound {
            if b == name {
                return true
            }
        }
        return false
    }

    // Run a service provider's setup against this app (register controllers, config, middleware).
    fn provider(p: dyn ServiceProvider): void {
        p.register(self)
    }

    // Set an app configuration value (providers write it during setup).
    fn configure(key: string, value: string): void {
        self.config.set(key, value)
    }

    // Read an app configuration value, or `fallback` if unset.
    fn setting(key: string, fallback: string): string {
        return self.config.get(key, fallback)
    }

    // Add a middleware to the pipeline (run in registration order before every handler).
    fn use_middleware(mw: dyn Middleware): void {
        self.middleware = self.middleware ~ [mw]
    }

    // Register a controller instance under its type name (the leading segment of its route targets).
    fn register(name: string, controller: dyn): void {
        self.controllers = self.controllers.set(name, controller)
    }

    // Build the route table from every route attribute in the program.
    //
    // One loop per verb, because `attributes_of::<T>()` is a closed-world query keyed by type: there
    // is no "every attribute" query to write this as one pass, and that is the same property that
    // makes a misspelled attribute a compile error instead of a route that never matches.
    fn discover(): void {
        mut table: List<Route> = self.routes
        for a in attributes_of::<Get>() {
            table = table ~ [route_for("GET", a.target, a.value.path)]
        }
        for a in attributes_of::<Post>() {
            table = table ~ [route_for("POST", a.target, a.value.path)]
        }
        for a in attributes_of::<Put>() {
            table = table ~ [route_for("PUT", a.target, a.value.path)]
        }
        for a in attributes_of::<Patch>() {
            table = table ~ [route_for("PATCH", a.target, a.value.path)]
        }
        for a in attributes_of::<Delete>() {
            table = table ~ [route_for("DELETE", a.target, a.value.path)]
        }
        for a in attributes_of::<Query>() {
            table = table ~ [route_for("QUERY", a.target, a.value.path)]
        }
        self.routes = table
    }

    // Mount a directory of static assets, served for GETs that match no route. This is the
    // framework's job rather than the templating package's: aether owns the router and the
    // fall-through, and "no route matched, try the filesystem" is a routing decision.
    fn serve_files(dir: string): void {
        self.static_dir = dir
    }

    // Add a route the attribute scan cannot express: one whose path is decided at runtime.
    //
    // `#[Get("/path")]` takes a literal, which is right for an application's own endpoints — a route
    // that can move at runtime is a route no tool can find. This is the seam for the routes a
    // *library* contributes on the caller's terms, where the path is the caller's choice: the
    // generated OpenAPI document at whatever URL the app wants it (`openapi.expose`). Build the row
    // with `route_for`, so a hand-added route carries the same reflection target every discovered one
    // does and its handler's parameters are injected identically.
    fn add_route(r: Route): void {
        self.routes = self.routes ~ [r]
    }

    // The discovered route table, in discovery order. What a spec generator reads: `para.aether`'s
    // own `openapi` module turns this plus each handler's reflected signature into an OpenAPI
    // document, and it must read the SAME table the router dispatches against — a spec derived from
    // a second traversal could describe routes the app does not serve.
    fn route_table(): List<Route> {
        return self.routes
    }

    // The string-testable entry point: resolve + dispatch, then hand back the response *body* as a
    // plain string. It exists so an app can drive its whole DI + route-model-binding path with no
    // server (`app.handle("POST", "/users", body)`); the reply's status and headers are the server
    // path's concern (`serve_request`), so extracting `.body()` here is exactly the projection that
    // keeps this call byte-for-byte what it always returned — including "404 Not Found" and the
    // "500 …" strings, which are now the bodies of a 404/500 `Response`. No live request to inject,
    // so a handler that declares a `Request` parameter is exercised through `serve`, not this call.
    fn handle(method: string, path: string, body: string): string {
        return self.resolve(method, path, body, none).body()
    }

    // The `Response`-returning twin of `handle`, for when the status or a header is the point —
    // a static asset's `Content-Type`, a 404, a redirect. Same resolution, no projection.
    fn respond(method: string, path: string, body: string): Response {
        return self.resolve(method, path, body, none)
    }

    // The route-matching core shared by the string path (`handle`, an absent request) and the server
    // path (`serve_request`, the live request). A matched route dispatches with the optional request
    // in scope, so a handler parameter typed `Request` can be injected when one is available. Returns
    // a full `Response` — status and headers included — so the server path carries them verbatim and
    // the string path projects out the body.
    fn resolve(method: string, path: string, body: string, req: ?Request): Response {
        // The string path carries its query in the path it was handed (`"/pets?status=sold"`); the
        // server path never does (`Request.path()` strips it, `Request.query` reads it). Splitting
        // here is what lets one route table serve both, and what lets a test rehearse a query
        // without a socket.
        (bare, raw_query) = split_query(path)
        for r in self.routes {
            if r.method == method {
                match path_match(r.path, bare) {
                    some(captures) => {
                        return self.dispatch(r, Bind {
                            path: captures,
                            query: parse_query(raw_query),
                            body: body,
                            req: req,
                            // Route-model binding takes the FIRST `{…}` of the template, in pattern
                            // order — a map's keys are sorted, so the order is read off the route.
                            id: if r.path_params.len() > 0 then captures.get_or(r.path_params[0], "") else "",
                        })
                    },
                    none => {},
                }
            }
        }
        // No route matched. If a static mount is configured, a GET may still be a file on disk —
        // the "no route matched, try the filesystem" step every web framework ends up owning.
        if method == "GET" && self.static_dir != "" {
            hit = self.static_file(path)
            if hit != none {
                return hit ?? server.response(404, "404 Not Found")
            }
        }
        return server.response(404, "404 Not Found")
    }

    // Serve `path` from the static mount, or `none` when it names no file there.
    //
    // The load-bearing part is the traversal guard: a request path is attacker-controlled, so
    // `/../../etc/passwd` must not escape the mount. Rather than normalizing (and re-deriving
    // every trick that defeats normalization), any segment that is `..` — or empty, or `.` —
    // rejects the request outright, and the rebuilt path is joined from the segments that
    // survived. A percent-encoded `%2e%2e` is decoded FIRST, so it is caught by the same rule.
    fn static_file(path: string): ?Response {
        decoded = url.decode(path)
        mut parts: List<string> = []
        for seg in decoded.split("/") {
            if seg == "" {
                continue
            }
            if seg == "." || seg == ".." {
                return none
            }
            // A backslash segment would be a path separator on some hosts; refuse rather than guess.
            if seg.contains("\\") {
                return none
            }
            parts = parts ~ [seg]
        }
        if parts.len() == 0 {
            return none
        }
        file = self.static_dir ~ "/" ~ parts.join("/")
        if !fs.exists(file) {
            return none
        }
        ct = content_type(parts[parts.len() - 1])
        // Text is served as text and binary as bytes, so a response body reads back as what the
        // file actually is (`.body()` on a bytes response renders as a byte count, not content).
        if is_text(ct) {
            return some(server.response(200, fs.read(file), { "content-type": ct }))
        }
        return some(server.response(200, fs.read_bytes(file), { "content-type": ct }))
    }

    // Dispatch a matched route: look up its controller instance and invoke the action with everything
    // the request offers an injected parameter.
    fn dispatch(r: Route, bind: Bind): Response {
        if self.controllers.has(r.controller) {
            return self.invoke_action(self.controllers[r.controller], r, bind)
        }
        return server.response(500, "500 no controller ${r.controller}")
    }

    // Invoke a controller action with its injected arguments and coerce the result into a `Response`
    // (see `coerce_response`). An invocation error is a `500` whose body is the error.
    fn invoke_action(ctrl: dyn, r: Route, bind: Bind): Response {
        // `r.target` — the reflection key VERBATIM, not a rebuilt `"${controller}.${action}"`: a
        // controller declared under a `namespace` reflects fully qualified, and the short spelling
        // finds no parameter list at all (`params_of` answers `[]` for an unknown key), so every
        // handler with a parameter would be invoked with none and fail arity.
        return match self.build_args(r.target, bind) {
            Ok(args) => match invoke(ctrl, r.action, args) {
                Ok(result) => coerce_response(result, r.status),
                Err(e) => server.response(500, "500 ${e}"),
            },
            Err(resp) => resp,
        }
    }

    // Build the handler's argument list by reflecting its parameters (`params_of`) and injecting each
    // one by its declared type — a for-loop, not `.map`, because the injection reads `self` and any one
    // parameter may fail the whole build (an unregistered service, a missing path parameter) into a
    // short-circuit response.
    fn build_args(target: string, bind: Bind): Result<List<dyn>, Response> {
        mut args: List<dyn> = []
        for p in params_of(target) {
            match self.arg_for(p, bind) {
                Ok(a) => { args = args ~ [a] },
                Err(resp) => { return Err(resp) },
            }
        }
        return Ok(args)
    }

    // Inject one parameter by its reflected type:
    //   - `dyn Trait`     → the service registered for that interface (injection by interface),
    //   - `Request`       → the live HTTP request (server path only; see `request_arg`),
    //   - a scalar        → the route parameter or query parameter of the SAME NAME, parsed,
    //   - `?scalar`       → the same, `none` when absent instead of a 400,
    //   - a nominal type  → route-model binding (if `bind_model`'d) else request-body decode.
    //
    // The scalar arms are what let a handler read the URL: `fn show(id: string)` on `/pets/{id}`
    // binds by NAME, not by position, so reordering the parameters cannot silently swap them. A name
    // that is not a `{…}` of the route falls through to the query string, which is the other place a
    // scalar can come from — one rule, checked in the order a URL is written.
    //
    // `Request` reflects as `Named("Request", [])` — the extern type's short name — so it is caught
    // inside the `Named` arm ahead of the body-decode fallback that would otherwise swallow it into a
    // JSON panic. A user body struct must not be named `Request`, which is the extern type's name.
    // Returns a `Result` so an unresolvable `dyn` service becomes a `500` the caller renders, not a
    // panic — the only injection outcome that is a *configuration* error rather than a client error.
    fn arg_for(p: ParamInfo, bind: Bind): Result<dyn, Response> {
        return match p.type {
            DynTrait(n) => self.resolve_service(n),
            Struct(n, _) => Ok(self.materialize(n, bind)),
            Class(n, _) => Ok(self.materialize(n, bind)),
            Named(n, _) => if n == "Request" then Ok(request_arg(bind.req)) else Ok(self.materialize(n, bind)),
            Type.String => scalar_arg(p, bind),
            Type.Int => scalar_arg(p, bind),
            Type.Float => scalar_arg(p, bind),
            Type.F32 => scalar_arg(p, bind),
            Type.F64 => scalar_arg(p, bind),
            Type.Bool => scalar_arg(p, bind),
            Option(_) => scalar_arg(p, bind),
            _ => Err(server.response(500, "500 cannot inject `${p.name}`: no rule for a parameter of this type")),
        }
    }

    // Resolve a `dyn Trait` parameter to the service registered for its interface. The reflected trait
    // name is fully qualified; the container keys on the short name (`short_iface`), so a `dyn Store` /
    // `dyn SessionStore` / `dyn Clock` finds the instance `bind`'d under `"Store"` / `"SessionStore"` /
    // `"Clock"`. An interface with no registered service is a configuration error, not a client one:
    // a `500` naming the interface and how to provide it — never the wrong service silently injected.
    fn resolve_service(name: string): Result<dyn, Response> {
        key = short_iface(name)
        if self.services.has(key) {
            return Ok(self.services[key])
        }
        return Err(server.response(500, "500 no service registered for `dyn ${key}` — bind one during setup with `app.bind(\"${key}\", <instance>)` (or `app.set_store(...)` for the data `Store`)"))
    }

    // A nominal parameter is either a route-bound model (loaded from the store by the route id) or a
    // request body materialized into a typed struct via `@derive(Deserialize<Json>)`.
    //
    // A browser `<form>` posts `application/x-www-form-urlencoded`, not JSON, so a handler that
    // declares a body struct would otherwise 400 on every form submission. The form body is
    // converted to a JSON object first and then decoded through the SAME typed door, so a struct
    // needs no second derive and the two content types stay one code path.
    fn materialize(name: string, bind: Bind): dyn {
        if self.is_bound(name) {
            return self.store.load(name, bind.id)
        }
        payload = if is_form_request(bind.req) then form_to_json(server.parse_form(bind.body)) else bind.body
        return match json.decode_typed(name, payload) {
            Ok(v) => v,
            Err(e) => panic("400 ${e}"),
        }
    }

    // The HTTP adapter: enter the middleware onion at its outermost layer. Each layer may rewrite the
    // request, inspect or replace the response, or short-circuit; `Next.run` bottoms out in
    // `serve_request`, which dispatches the route and flushes the unit-of-work. The first middleware
    // registered is the outermost — it sees the request first and the response last.
    fn route(req: Request): Response {
        return Next { stack: self.middleware, index: 0, app: self }.run(req)
    }

    // The string-testable request cycle: dispatch to the routed handler, then commit the request's
    // unit-of-work (a no-op if nothing was staged). The same sequence `serve_request` runs for a live
    // HTTP request, without the `Request`/`Response` wrappers — so an app can test its whole DI +
    // route-model-binding + flush path with plain string calls (no server, no sockets).
    fn dispatch_request(method: string, path: string, body: string): string {
        out = self.handle(method, path, body)
        self.store.flush()
        return out
    }

    // Dispatch one live HTTP request to its handler, then commit the unit-of-work. Unlike the
    // string-testable `dispatch_request`, this threads the live `Request` down to `arg_for` (so a
    // `Request` parameter is injected with the real one) AND returns the handler's `Response`
    // verbatim — its status and headers reach the client, where `dispatch_request` projected only the
    // body to a string. The route → flush sequence is otherwise identical, so the string path stays a
    // faithful rehearsal of the server path. It is the onion's terminal — `Next.run` calls it once
    // the pipeline is exhausted.
    fn serve_request(req: Request): Response {
        resp = self.resolve(req.method(), req.path(), req.body(), some(req))
        self.store.flush()
        return resp
    }

    // Run the app on `port`, dispatching each request through the router.
    fn serve(port: int): void {
        server.serve(port, self.route)
    }
}

// The `Content-Type` for a filename, by extension. Deliberately a small, explicit table rather
// than a guess: an unknown extension serves as `application/octet-stream`, which a browser
// downloads instead of interpreting — the safe default for a file the framework cannot classify.
fn content_type(name: string): string {
    lower = name.lower()
    if lower.ends_with(".html") || lower.ends_with(".htm") { return "text/html; charset=utf-8" }
    if lower.ends_with(".css") { return "text/css; charset=utf-8" }
    if lower.ends_with(".js") || lower.ends_with(".mjs") { return "text/javascript; charset=utf-8" }
    if lower.ends_with(".json") { return "application/json" }
    if lower.ends_with(".svg") { return "image/svg+xml" }
    if lower.ends_with(".png") { return "image/png" }
    if lower.ends_with(".jpg") || lower.ends_with(".jpeg") { return "image/jpeg" }
    if lower.ends_with(".gif") { return "image/gif" }
    if lower.ends_with(".webp") { return "image/webp" }
    if lower.ends_with(".ico") { return "image/x-icon" }
    if lower.ends_with(".woff2") { return "font/woff2" }
    if lower.ends_with(".woff") { return "font/woff" }
    if lower.ends_with(".txt") { return "text/plain; charset=utf-8" }
    if lower.ends_with(".xml") { return "application/xml" }
    if lower.ends_with(".pdf") { return "application/pdf" }
    return "application/octet-stream"
}

// Whether a `Content-Type` names text — the ones whose bodies are meaningful as strings. Keyed on
// the type the table above produced, so the two stay in step.
fn is_text(ct: string): bool {
    return ct.starts_with("text/") || ct.starts_with("application/json")
        || ct.starts_with("application/xml") || ct.starts_with("image/svg+xml")
}

// Whether this request carries a form body rather than JSON. Keyed on `Content-Type`, which is the
// signal that actually distinguishes them — sniffing the body's shape would misread a form field
// whose value happens to start with `{`.
fn is_form_request(req: ?Request): bool {
    return match req {
        some(r) => (r.header("content-type") ?? "").lower().contains("application/x-www-form-urlencoded"),
        none => false,
    }
}

// Render decoded form fields as a JSON object, so a form body reaches the same typed decode a JSON
// body does.
//
// Every form value arrives as text, but a struct field may be an `int` or a `bool` — so a value
// that reads as a number or a boolean is emitted as that JSON scalar and everything else is
// emitted as a quoted string. This is the ordinary form-binder convention; a field genuinely
// meant to hold the text "true" needs a JSON body.
fn form_to_json(fields: Map<string, string>): string {
    mut parts: List<string> = []
    for key in fields.keys() {
        parts = parts ~ ["${json.stringify(key)}:${form_scalar(fields.get_or(key, ""))}"]
    }
    return "{" ~ parts.join(",") ~ "}"
}

// One form value as a JSON scalar: `true`/`false` and anything parsing as a number stay bare; the
// rest is a quoted string.
fn form_scalar(value: string): string {
    if value == "true" || value == "false" {
        return value
    }
    if value.to_int() != none {
        return value
    }
    if value.to_float() != none {
        return value
    }
    return json.stringify(value)
}
